summarise(across(C1:P10, ~ sd(.x, na.rm = TRUE)))
)
sds[[length(sds)+1]] <- tibble(
model = model2,
survey,
prompt_uid,
m2_data %>%
summarise(across(C1:P10, ~ sd(.x, na.rm = TRUE)))
)
}
sds <- bind_rows(sds)
write_csv(sds, "data/detailed_analysis.csv")
# use model name instead of model for plots
